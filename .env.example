APP_NAME="Framework"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_RUNTIME=swoole
APP_KEY=
SESSION_COOKIE=DSF_SESSID
SESSION_LIFETIME=120
SESSION_SECURE=false

# HTTP Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Swoole runtime
SWOOLE_WORKERS=4
SWOOLE_TASK_WORKERS=0
SWOOLE_COROUTINE=true
SWOOLE_MAX_REQUEST=10000
SWOOLE_MAX_CONN=1024
SWOOLE_MAX_PACKAGE_SIZE=2097152

# WebSocket (separate listener; configure when enabled)
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=6001
WEBSOCKET_PATH=/ws

# Authentication
AUTH_GUARD=token
BCRYPT_ROUNDS=10

# Broadcasting
BROADCAST_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BROADCAST_DB=1

# CORS
CORS_ORIGIN=*

# Database
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=framework
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_POOL_MAX=10
DB_POOL_TIMEOUT=3
