APP_NAME="Framework"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_RUNTIME=swoole

# HTTP Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Swoole runtime
SWOOLE_WORKERS=4
SWOOLE_TASK_WORKERS=0
SWOOLE_COROUTINE=true
SWOOLE_MAX_REQUEST=10000
SWOOLE_MAX_CONN=1024

# WebSocket (separate listener; configure when enabled)
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=6001
WEBSOCKET_PATH=/ws

# Authentication
AUTH_GUARD=token
BCRYPT_ROUNDS=10

# Broadcasting
BROADCAST_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BROADCAST_DB=1

# CORS
CORS_ORIGIN=*

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=framework
